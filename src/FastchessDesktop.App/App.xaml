<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FastchessDesktop.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- Engine rating tiers of 200 Elo (EngineViewModel.TierOf); 0 is not rated. Used by TierColors and the legend. -->
            <SolidColorBrush x:Key="RatingTier0Brush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="RatingTier1Brush" Color="#C58AF9" />
            <SolidColorBrush x:Key="RatingTier2Brush" Color="#8AB4F8" />
            <SolidColorBrush x:Key="RatingTier3Brush" Color="#78D9EC" />
            <SolidColorBrush x:Key="RatingTier4Brush" Color="#81C995" />
            <SolidColorBrush x:Key="RatingTier5Brush" Color="#E8C06A" />
            <SolidColorBrush x:Key="RatingTier6Brush" Color="#F6AE7C" />

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="TableHeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Grid tables (tournament standings and finished games): every cell has a right and bottom rule. -->
            <Style x:Key="TableHeaderCellStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="TableCellStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="6,3" />
            </Style>
            <Style x:Key="TableSortButtonStyle" TargetType="Button" BasedOn="{StaticResource TableHeaderButtonStyle}">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style x:Key="TableSortButtonRightStyle" TargetType="Button" BasedOn="{StaticResource TableSortButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
            <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="6,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="TableTextStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="TableNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TableTextStyle}">
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
            <Style x:Key="TableRowStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
