<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FastchessDesktop.App.Views.TournamentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FastchessDesktop.ViewModels"
    xmlns:views="using:FastchessDesktop.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:services="using:FastchessDesktop.App.Services"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Configuration. The right margin keeps content clear of the overlay scroll bar. -->
        <ScrollViewer>
            <StackPanel Spacing="8" Margin="0,0,20,0">

                <Expander Header="Engines" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="4" Grid.ColumnSpan="2">
                            <Button Content="Add engine..." Command="{x:Bind ViewModel.AddEngineCommand}" />
                            <Button Content="Duplicate" Command="{x:Bind ViewModel.DuplicateEngineCommand}" />
                            <Button Content="Remove" Command="{x:Bind ViewModel.RemoveEngineCommand}" />
                        </StackPanel>

                        <ListView Grid.Row="1" MinHeight="160" MaxHeight="320"
                                  ItemsSource="{x:Bind ViewModel.Engines}"
                                  SelectedItem="{x:Bind ViewModel.SelectedEngine, Mode=TwoWay}"
                                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:EngineViewModel">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Name (read from the engine)"
                                         Text="{x:Bind ViewModel.SelectedEngine.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Detect"
                                        ToolTipService.ToolTip="Start the engine and use the name it reports"
                                        Command="{x:Bind ViewModel.DetectEngineNameCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.SelectedEngine.Status, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Executable"
                                         Text="{x:Bind ViewModel.SelectedEngine.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="..."
                                        Command="{x:Bind ViewModel.BrowseEngineCommandCommand}" />
                            </Grid>
                            <TextBox Header="Arguments"
                                     Text="{x:Bind ViewModel.SelectedEngine.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Working directory (optional)"
                                     Text="{x:Bind ViewModel.SelectedEngine.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="UCI options, one Name=Value per line"
                                     Text="{x:Bind ViewModel.SelectedEngine.OptionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                     FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </Grid>
                </Expander>

                <Expander Header="Schedule and limits" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ComboBox Header="Tournament" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.TournamentTypeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Round robin" />
                            <ComboBoxItem Content="Gauntlet" />
                            <ComboBoxItem Content="Pyramid" />
                            <ComboBoxItem Content="Knockout" />
                            <ComboBoxItem Content="Swiss" />
                        </ComboBox>
                        <NumberBox Grid.Column="1" Header="Gauntlet seeds" Minimum="1"
                                   Value="{x:Bind ViewModel.Seeds, Mode=TwoWay}"
                                   Visibility="{x:Bind ViewModel.IsGauntlet, Mode=OneWay}" />
                        <NumberBox Grid.Column="1" Header="Swiss rounds" Minimum="1"
                                   Value="{x:Bind ViewModel.SwissRounds, Mode=TwoWay}"
                                   Visibility="{x:Bind ViewModel.IsSwiss, Mode=OneWay}" />
                        <NumberBox Grid.Column="1" Header="Tiebreak game pairs" Minimum="0"
                                   Value="{x:Bind ViewModel.KnockoutTiebreakPairs, Mode=TwoWay}"
                                   Visibility="{x:Bind ViewModel.IsKnockout, Mode=OneWay}" />
                        <NumberBox Grid.Column="2" Header="Rounds (game pairs per pairing)" Minimum="1"
                                   Value="{x:Bind ViewModel.Rounds, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" TextWrapping="Wrap"
                                   Text="{x:Bind ViewModel.FormatDescription, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <NumberBox Grid.Row="2" Header="Games per encounter" Minimum="1" Maximum="2"
                                   Value="{x:Bind ViewModel.GamesPerEncounter, Mode=TwoWay}" />
                        <NumberBox Grid.Row="2" Grid.Column="1" Header="Concurrency (0 = all threads)"
                                   Value="{x:Bind ViewModel.Concurrency, Mode=TwoWay}" />
                        <CheckBox Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" Content="Force concurrency"
                                  IsChecked="{x:Bind ViewModel.ForceConcurrency, Mode=TwoWay}" />

                        <ComboBox Grid.Row="3" Header="Limit" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.LimitKindIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Time control (tc)" />
                            <ComboBoxItem Content="Time per move (st)" />
                            <ComboBoxItem Content="Nodes" />
                            <ComboBoxItem Content="Depth" />
                        </ComboBox>
                        <TextBox Grid.Row="3" Grid.Column="1" Header="[moves/]seconds[+inc]"
                                 Text="{x:Bind ViewModel.TimeControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{x:Bind ViewModel.IsTimeControlLimit, Mode=OneWay}" />
                        <NumberBox Grid.Row="3" Grid.Column="1" Header="Seconds per move" Minimum="0" SmallChange="0.1"
                                   Value="{x:Bind ViewModel.MoveTimeSeconds, Mode=TwoWay}"
                                   Visibility="{x:Bind ViewModel.IsMoveTimeLimit, Mode=OneWay}" />
                        <NumberBox Grid.Row="3" Grid.Column="1" Header="Nodes per move" Minimum="1"
                                   Value="{x:Bind ViewModel.Nodes, Mode=TwoWay}"
                                   Visibility="{x:Bind ViewModel.IsNodesLimit, Mode=OneWay}" />
                        <NumberBox Grid.Row="3" Grid.Column="1" Header="Depth" Minimum="1"
                                   Value="{x:Bind ViewModel.Depth, Mode=TwoWay}"
                                   Visibility="{x:Bind ViewModel.IsDepthLimit, Mode=OneWay}" />
                        <NumberBox Grid.Row="3" Grid.Column="2" Header="Time margin (ms)" Minimum="0"
                                   Value="{x:Bind ViewModel.TimeMarginMs, Mode=TwoWay}" />

                        <NumberBox Grid.Row="4" Header="Threads per engine (0 = unset)" Minimum="0"
                                   Value="{x:Bind ViewModel.Threads, Mode=TwoWay}" />
                        <NumberBox Grid.Row="4" Grid.Column="1" Header="Hash MB per engine (0 = unset)" Minimum="0"
                                   Value="{x:Bind ViewModel.HashMb, Mode=TwoWay}" />
                    </Grid>
                </Expander>

                <Expander Header="Openings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.ColumnSpan="3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Opening book (EPD or PGN; empty = start position)"
                                     Text="{x:Bind ViewModel.OpeningsFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="..." Command="{x:Bind ViewModel.BrowseOpeningsCommand}" />
                        </Grid>
                        <ComboBox Grid.Row="1" Header="Format" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.OpeningsFormatIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="EPD" />
                            <ComboBoxItem Content="PGN" />
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="1" Header="Order" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.OpeningsOrderIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Sequential" />
                            <ComboBoxItem Content="Random" />
                        </ComboBox>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <NumberBox Header="PGN plies (0 = all)" Minimum="0" Width="84" Value="{x:Bind ViewModel.OpeningPlies, Mode=TwoWay}" />
                            <NumberBox Header="Start" Minimum="1" Width="72" Value="{x:Bind ViewModel.OpeningStart, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Expander>

                <Expander Header="Adjudication" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox VerticalAlignment="Bottom" Content="Draw" IsChecked="{x:Bind ViewModel.DrawAdjudication, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1" Header="After move" Value="{x:Bind ViewModel.DrawMoveNumber, Mode=TwoWay}" />
                        <NumberBox Grid.Column="2" Header="For moves" Value="{x:Bind ViewModel.DrawMoveCount, Mode=TwoWay}" />
                        <NumberBox Grid.Column="3" Header="Within cp" Value="{x:Bind ViewModel.DrawScore, Mode=TwoWay}" />

                        <CheckBox Grid.Row="1" VerticalAlignment="Bottom" Content="Resign" IsChecked="{x:Bind ViewModel.ResignAdjudication, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Grid.Column="1" Header="For moves" Value="{x:Bind ViewModel.ResignMoveCount, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Grid.Column="2" Header="Beyond cp" Value="{x:Bind ViewModel.ResignScore, Mode=TwoWay}" />
                        <CheckBox Grid.Row="1" Grid.Column="3" VerticalAlignment="Bottom" Content="Two-sided"
                                  IsChecked="{x:Bind ViewModel.ResignTwoSided, Mode=TwoWay}" />

                        <NumberBox Grid.Row="2" Header="Max moves (0 = off)" Minimum="0" Value="{x:Bind ViewModel.MaxMoves, Mode=TwoWay}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Header="Syzygy paths (; separated)"
                                 Text="{x:Bind ViewModel.TablebasePaths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <NumberBox Grid.Row="2" Grid.Column="3" Header="TB pieces" Minimum="0" Value="{x:Bind ViewModel.TablebasePieces, Mode=TwoWay}" />
                    </Grid>
                </Expander>

                <Expander Header="SPRT" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox VerticalAlignment="Bottom" Content="Enable SPRT (two engines)" IsChecked="{x:Bind ViewModel.Sprt, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1" Header="elo0" SmallChange="0.5" Value="{x:Bind ViewModel.SprtElo0, Mode=TwoWay}" />
                        <NumberBox Grid.Column="2" Header="elo1" SmallChange="0.5" Value="{x:Bind ViewModel.SprtElo1, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Header="alpha" SmallChange="0.01" Value="{x:Bind ViewModel.SprtAlpha, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Grid.Column="1" Header="beta" SmallChange="0.01" Value="{x:Bind ViewModel.SprtBeta, Mode=TwoWay}" />
                        <ComboBox Grid.Row="1" Grid.Column="2" Header="Model" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.SprtModelIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Normalized" />
                            <ComboBoxItem Content="Logistic" />
                            <ComboBoxItem Content="Bayesian" />
                        </ComboBox>
                    </Grid>
                </Expander>

                <Expander Header="Output and recovery" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Header="Event" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.Event, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="2" Header="Site" Text="{x:Bind ViewModel.Site, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="PGN output (empty = a new file in the run folder)"
                                     Text="{x:Bind ViewModel.PgnOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="..." Command="{x:Bind ViewModel.BrowsePgnOutCommand}" />
                        </Grid>
                        <ComboBox Grid.Row="2" Header="Notation" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.PgnNotationIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="SAN" />
                            <ComboBoxItem Content="LAN" />
                            <ComboBoxItem Content="UCI" />
                        </ComboBox>
                        <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Content="Append" IsChecked="{x:Bind ViewModel.PgnAppend, Mode=TwoWay}" />
                        <CheckBox Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" Content="Minimal PGN" IsChecked="{x:Bind ViewModel.PgnMinimal, Mode=TwoWay}" />
                        <CheckBox Grid.Row="3" Content="Nodes, seldepth and nps in comments" Grid.ColumnSpan="2"
                                  IsChecked="{x:Bind ViewModel.PgnSearchInfo, Mode=TwoWay}" />
                        <TextBox Grid.Row="3" Grid.Column="2" Header="Final EPD file (optional)"
                                 Text="{x:Bind ViewModel.EpdOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="4" VerticalAlignment="Bottom" Content="Recover crashed engines" IsChecked="{x:Bind ViewModel.Recover, Mode=TwoWay}" />
                        <NumberBox Grid.Row="4" Grid.Column="1" Header="Autosave every N games" Minimum="0" Value="{x:Bind ViewModel.AutosaveInterval, Mode=TwoWay}" />
                        <NumberBox Grid.Row="4" Grid.Column="2" Header="Rating report interval" Minimum="0" Value="{x:Bind ViewModel.RatingInterval, Mode=TwoWay}" />

                        <TextBox Grid.Row="5" Header="Protocol log file (optional)"
                                 Text="{x:Bind ViewModel.LogFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Header="Log level" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.LogLevelIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="trace" />
                            <ComboBoxItem Content="info" />
                            <ComboBoxItem Content="warn" />
                            <ComboBoxItem Content="err" />
                            <ComboBoxItem Content="fatal" />
                        </ComboBox>
                        <CheckBox Grid.Row="5" Grid.Column="2" VerticalAlignment="Bottom" Content="Engine traffic"
                                  IsChecked="{x:Bind ViewModel.LogEngineTraffic, Mode=TwoWay}" />
                    </Grid>
                </Expander>

                <Expander Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBox Header="Opening shuffle seed (-srand; empty = random)"
                                 Text="{x:Bind ViewModel.Srand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Cutechess-compatible console output" IsChecked="{x:Bind ViewModel.CutechessOutput, Mode=TwoWay}" />
                        <CheckBox Content="Pentanomial statistics" IsChecked="{x:Bind ViewModel.ReportPenta, Mode=TwoWay}" />
                        <TextBox Header="Extra fastchess arguments (appended as typed)"
                                 Text="{x:Bind ViewModel.ExtraArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Drag to resize the two panels. -->
        <toolkit:GridSplitter Grid.Column="1" Width="12" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

        <!-- Run control and output -->
        <Grid Grid.Column="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Content="Start" MinWidth="96" Command="{x:Bind ViewModel.StartCommand}" />
                <Button Content="Stop" MinWidth="96" Command="{x:Bind ViewModel.StartCancelCommand}" />
                <CheckBox VerticalAlignment="Center" Content="Import games into the open database when finished"
                          IsChecked="{x:Bind ViewModel.ImportResults, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="4">
                <ProgressBar Value="{x:Bind ViewModel.GamesFinished, Mode=OneWay}" Maximum="{x:Bind ViewModel.GamesTotal, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Expander Grid.Row="3" Header="Command line" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <TextBox Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="{StaticResource MonoFont}" MaxHeight="160" />
            </Expander>

            <Pivot Grid.Row="4">
                <PivotItem Header="Log">
                    <views:LogPanel Log="{x:Bind ViewModel.Log}" Margin="0,8,0,0" />
                </PivotItem>
                <PivotItem Header="Standings">
                    <Grid RowSpacing="8" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Head-to-head figures and SPRT, as fastchess reports them, when exactly two engines play. -->
                        <Grid Visibility="{x:Bind ViewModel.HasMatchSummary, Mode=OneWay}" ColumnSpacing="12" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="4" Text="{x:Bind ViewModel.MatchTitle, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Style="{StaticResource SummaryLabelStyle}" Text="Elo" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.MatchElo, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SummaryLabelStyle}" Text="nElo" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.MatchNElo, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource SummaryLabelStyle}" Text="LOS" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.MatchLos, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SummaryLabelStyle}" Text="Draw ratio" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Bind ViewModel.MatchDrawRatio, Mode=OneWay}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource SummaryLabelStyle}" Text="Games" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.MatchGames, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SummaryLabelStyle}" Text="Ptnml(0-2)" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{x:Bind ViewModel.MatchPtnml, Mode=OneWay}" TextWrapping="Wrap" />
                            <Grid Grid.Row="4" Grid.ColumnSpan="4" ColumnSpacing="12" Margin="0,6,0,0"
                                  Visibility="{x:Bind ViewModel.HasSprt, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="SPRT" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SprtHypotheses, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SprtLlr, Mode=OneWay}" FontWeight="SemiBold"
                                           ToolTipService.ToolTip="Log-likelihood ratio, and progress toward the nearer bound" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.SprtBounds, Mode=OneWay}"
                                           ToolTipService.ToolTip="Bounds: H0 is accepted at the lower, H1 at the upper" />
                                <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
                                    <ProgressBar Value="{x:Bind ViewModel.SprtProgress, Mode=OneWay}" Maximum="100" />
                                    <TextBlock Text="{x:Bind ViewModel.SprtStatus, Mode=OneWay}" Style="{StaticResource SummaryLabelStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Column widths must match the item template below. Click a header to sort; click again to reverse. -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('#', 'Rank', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Rank"
                                                    ToolTipService.ToolTip="Rank by Elo, as fastchess ranks" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Engine', 'Engine', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Engine" />
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Elo', 'Elo', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Elo"
                                                    ToolTipService.ToolTip="Elo difference against the field, from game pairs when fastchess reports pentanomial statistics" />
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('+/-', 'Error', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Error"
                                                    ToolTipService.ToolTip="95% confidence margin of the Elo" />
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('nElo', 'NElo', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="NElo"
                                                    ToolTipService.ToolTip="Normalized Elo: the score difference scaled by its spread" />
                                        </Border>
                                        <Border Grid.Column="5" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('+/-', 'NEloError', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="NEloError"
                                                    ToolTipService.ToolTip="95% confidence margin of the normalized Elo" />
                                        </Border>
                                        <Border Grid.Column="6" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('LOS', 'Los', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Los"
                                                    ToolTipService.ToolTip="Likelihood of superiority: the chance the engine is stronger than the field" />
                                        </Border>
                                        <Border Grid.Column="7" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Games', 'Games', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Games" />
                                        </Border>
                                        <Border Grid.Column="8" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Points', 'Points', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Points" />
                                        </Border>
                                        <Border Grid.Column="9" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Score', 'Score', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Score"
                                                    ToolTipService.ToolTip="Points as a percentage of games played" />
                                        </Border>
                                        <Border Grid.Column="10" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('W', 'Wins', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Wins" />
                                        </Border>
                                        <Border Grid.Column="11" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('D', 'Draws', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Draws" />
                                        </Border>
                                        <Border Grid.Column="12" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('L', 'Losses', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Losses" />
                                        </Border>
                                        <Border Grid.Column="13" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Draw', 'DrawRatio', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="DrawRatio"
                                                    ToolTipService.ToolTip="Drawn games as a percentage of games played" />
                                        </Border>
                                        <Border Grid.Column="14" Style="{StaticResource TableHeaderCellStyle}">
                                            <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Ptnml(0-2)"
                                                       ToolTipService.ToolTip="Game pairs scoring 0, 0.5, 1, 1.5 and 2 points (LL, LD, WL+DD, WD, WW)" />
                                        </Border>
                                        <Border Grid.Column="15" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Change', 'Change', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Change"
                                                    ToolTipService.ToolTip="How much the engine's latest result moved its Elo" />
                                        </Border>
                                        <Border Grid.Column="16" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Fail', 'Failures', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Failures"
                                                    ToolTipService.ToolTip="Games lost by time forfeit, crash, stalled connection or illegal move" />
                                        </Border>
                                        <Border Grid.Column="17" Style="{StaticResource TableHeaderCellStyle}">
                                            <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                    Content="{x:Bind vm:TableHeader.Label('Warn', 'Warnings', ViewModel.Standings.SortKey, ViewModel.Standings.SortDescending), Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.Standings.SortCommand}" CommandParameter="Warnings"
                                                    ToolTipService.ToolTip="fastchess warnings about the engine's search output (they do not affect results)" />
                                        </Border>
                                    </Grid>
                                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Standings.Rows}" SelectionMode="None"
                                              ItemContainerStyle="{StaticResource TableRowStyle}">
                                        <ListView.ItemContainerTransitions>
                                            <TransitionCollection />
                                        </ListView.ItemContainerTransitions>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StandingRow">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="68" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind RankText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="1" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableTextStyle}" Text="{x:Bind Engine}" FontWeight="SemiBold" /></Border>
                                                    <Border Grid.Column="2" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind EloText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="3" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind ErrorText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="4" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind NEloText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="5" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind NEloErrorText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="6" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind LosText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="7" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind GamesText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="8" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind PointsText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="9" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind ScoreText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="10" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind WinsText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="11" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind DrawsText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="12" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind LossesText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="13" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind DrawRatioText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="14" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind PtnmlText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="15" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind ChangeText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="16" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind FailuresText, Mode=OneWay}" /></Border>
                                                    <Border Grid.Column="17" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind WarningsText, Mode=OneWay}" /></Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </PivotItem>
                <PivotItem Header="Finished games">
                    <!-- Column widths must match the item template below. Click a header to sort; click again to reverse. -->
                    <ScrollViewer Margin="0,8,0,0" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource TableHeaderCellStyle}">
                                        <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                Content="{x:Bind vm:TableHeader.Label('#', 'Number', ViewModel.FinishedGames.SortKey, ViewModel.FinishedGames.SortDescending), Mode=OneWay}"
                                                Command="{x:Bind ViewModel.FinishedGames.SortCommand}" CommandParameter="Number" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource TableHeaderCellStyle}">
                                        <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                Content="{x:Bind vm:TableHeader.Label('Pair', 'Pair', ViewModel.FinishedGames.SortKey, ViewModel.FinishedGames.SortDescending), Mode=OneWay}"
                                                Command="{x:Bind ViewModel.FinishedGames.SortCommand}" CommandParameter="Pair"
                                                ToolTipService.ToolTip="Game pair: the games played on one opening with colors swapped" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource TableHeaderCellStyle}">
                                        <Button Style="{StaticResource TableSortButtonStyle}"
                                                Content="{x:Bind vm:TableHeader.Label('White', 'White', ViewModel.FinishedGames.SortKey, ViewModel.FinishedGames.SortDescending), Mode=OneWay}"
                                                Command="{x:Bind ViewModel.FinishedGames.SortCommand}" CommandParameter="White" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource TableHeaderCellStyle}">
                                        <Button Style="{StaticResource TableSortButtonStyle}"
                                                Content="{x:Bind vm:TableHeader.Label('Black', 'Black', ViewModel.FinishedGames.SortKey, ViewModel.FinishedGames.SortDescending), Mode=OneWay}"
                                                Command="{x:Bind ViewModel.FinishedGames.SortCommand}" CommandParameter="Black" />
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource TableHeaderCellStyle}">
                                        <Button Style="{StaticResource TableSortButtonStyle}"
                                                Content="{x:Bind vm:TableHeader.Label('Result', 'Result', ViewModel.FinishedGames.SortKey, ViewModel.FinishedGames.SortDescending), Mode=OneWay}"
                                                Command="{x:Bind ViewModel.FinishedGames.SortCommand}" CommandParameter="Result" />
                                    </Border>
                                    <Border Grid.Column="5" Style="{StaticResource TableHeaderCellStyle}">
                                        <Button Style="{StaticResource TableSortButtonStyle}"
                                                Content="{x:Bind vm:TableHeader.Label('Termination', 'Reason', ViewModel.FinishedGames.SortKey, ViewModel.FinishedGames.SortDescending), Mode=OneWay}"
                                                Command="{x:Bind ViewModel.FinishedGames.SortCommand}" CommandParameter="Reason"
                                                ToolTipService.ToolTip="How the game ended; engine failures are red" />
                                    </Border>
                                    <Border Grid.Column="6" Style="{StaticResource TableHeaderCellStyle}">
                                        <Button Style="{StaticResource TableSortButtonStyle}"
                                                Content="{x:Bind vm:TableHeader.Label('Started', 'Started', ViewModel.FinishedGames.SortKey, ViewModel.FinishedGames.SortDescending), Mode=OneWay}"
                                                Command="{x:Bind ViewModel.FinishedGames.SortCommand}" CommandParameter="Started" />
                                    </Border>
                                    <Border Grid.Column="7" Style="{StaticResource TableHeaderCellStyle}">
                                        <Button Style="{StaticResource TableSortButtonRightStyle}"
                                                Content="{x:Bind vm:TableHeader.Label('Time', 'Duration', ViewModel.FinishedGames.SortKey, ViewModel.FinishedGames.SortDescending), Mode=OneWay}"
                                                Command="{x:Bind ViewModel.FinishedGames.SortCommand}" CommandParameter="Duration"
                                                ToolTipService.ToolTip="Game duration (minutes:seconds)" />
                                    </Border>
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FinishedGames.Rows}" SelectionMode="None"
                                          ItemContainerStyle="{StaticResource TableRowStyle}">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection />
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FinishedGameRow">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="280" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind NumberText}" /></Border>
                                                <Border Grid.Column="1" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind PairText}" /></Border>
                                                <Border Grid.Column="2" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableTextStyle}" Text="{x:Bind White}" /></Border>
                                                <Border Grid.Column="3" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableTextStyle}" Text="{x:Bind Black}" /></Border>
                                                <Border Grid.Column="4" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableTextStyle}" Text="{x:Bind Result}" /></Border>
                                                <Border Grid.Column="5" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableTextStyle}" Text="{x:Bind Reason}" Foreground="{x:Bind services:TableColors.Termination(IsEngineFailure)}" /></Border>
                                                <Border Grid.Column="6" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableTextStyle}" Text="{x:Bind StartedText}" /></Border>
                                                <Border Grid.Column="7" Style="{StaticResource TableCellStyle}"><TextBlock Style="{StaticResource TableNumberStyle}" Text="{x:Bind DurationText}" /></Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>
